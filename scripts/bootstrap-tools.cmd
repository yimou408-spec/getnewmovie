@echo off
rem Inline PowerShell uses built-in Windows components; no execution-policy change.
rem Verified one-megabyte ranges keep proxy downloads bounded and resumable.
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -Command "$ErrorActionPreference='Stop'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $m=Get-Content -LiteralPath $env:MOVIE_TOOLCHAIN -Raw | ConvertFrom-Json; New-Item -ItemType Directory -Force -Path $env:MOVIE_BOOTSTRAP | Out-Null; $proxy=$env:MOVIE_DOWNLOAD_PROXY; if(!$proxy) { $proxy=$env:HTTPS_PROXY }; foreach($t in $m.tools) { $d=Join-Path $env:MOVIE_BOOTSTRAP $t.folder; if(Test-Path -LiteralPath (Join-Path $d $t.executable)) { continue }; $z=Join-Path $env:MOVIE_BOOTSTRAP $t.archive; if(!(Test-Path -LiteralPath $z) -or (Get-FileHash -LiteralPath $z -Algorithm SHA256).Hash -ne $t.sha256) { Write-Host ('Downloading '+$t.name+' '+$t.version); $p=$z+'.partial'; $f=[IO.File]::Open($p,[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::Write,[IO.FileShare]::None); try { if($f.Length -gt $t.size) { $f.SetLength(0) }; $f.Position=$f.Length; $u=$t.url; while($f.Position -lt $t.size) { $a=$f.Position; $b=[Math]::Min($a+1048575,$t.size-1); for($i=0;$i -lt 3;$i++) { try { $r=[Net.HttpWebRequest]::Create($u); $r.Timeout=20000; $r.ReadWriteTimeout=20000; $r.Accept='application/octet-stream'; if($proxy) { $r.Proxy=New-Object Net.WebProxy($proxy) }; $r.AddRange([long]$a,[long]$b); $s=$r.GetResponse(); $v=New-Object IO.MemoryStream; try { if($s.Headers['Content-Range'] -ne ('bytes '+$a+'-'+$b+'/'+$t.size)) { throw 'Unverified download range.' }; $u=$s.ResponseUri.AbsoluteUri; $s.GetResponseStream().CopyTo($v); if($v.Length -ne ($b-$a+1)) { throw 'Incomplete download range.' }; $data=$v.ToArray(); $f.Write($data,0,$data.Length) } finally { $s.Close(); $v.Dispose() }; break } catch { if($i -eq 2) { throw }; Write-Host ('Retrying '+$t.name+' download part') } }; if(($f.Position -band 4194303) -eq 0 -or $f.Position -eq $t.size) { Write-Host ($t.name+': '+$f.Position+'/'+$t.size+' bytes') } } } finally { $f.Dispose() }; if((Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash -ne $t.sha256) { Remove-Item -LiteralPath $p -Force; throw 'Tool download SHA256 mismatch; nothing was executed.' }; Move-Item -LiteralPath $p -Destination $z -Force }; Expand-Archive -LiteralPath $z -DestinationPath $d -Force; if(!(Test-Path -LiteralPath (Join-Path $d $t.executable))) { throw 'Official tool archive did not contain the expected executable.' }; Write-Host ($t.name+': SHA256 verified') }"
exit /b %errorlevel%
