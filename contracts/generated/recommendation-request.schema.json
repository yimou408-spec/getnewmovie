{
  "$defs": {
    "ClarificationAnswer": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "option": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Option",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "option"
      ],
      "title": "ClarificationAnswer",
      "type": "object"
    },
    "ClarificationSubmission": {
      "additionalProperties": false,
      "properties": {
        "clarification_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Clarification Id",
          "type": "string"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/ClarificationAnswer"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Answers",
          "type": "array"
        }
      },
      "required": [
        "clarification_id",
        "answers"
      ],
      "title": "ClarificationSubmission",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "max_runtime_minutes": {
          "anyOf": [
            {
              "maximum": 600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Runtime Minutes"
        },
        "exclude_movie_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Exclude Movie Ids",
          "type": "array"
        },
        "exclude_genres": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Exclude Genres",
          "type": "array"
        },
        "preferred_tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Preferred Tags",
          "type": "array"
        },
        "moods": {
          "items": {
            "enum": [
              "轻松解压",
              "温暖治愈",
              "烧脑过瘾",
              "浪漫心动",
              "惊奇冒险",
              "感动一下"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Moods",
          "type": "array"
        },
        "genres": {
          "items": {
            "enum": [
              "喜剧",
              "科幻与奇幻",
              "惊悚",
              "动作",
              "爱情",
              "动画",
              "剧情",
              "家庭",
              "纪录片",
              "恐怖"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Genres",
          "type": "array"
        },
        "company": {
          "default": "",
          "enum": [
            "",
            "一个人",
            "两个人",
            "和朋友",
            "和家人"
          ],
          "title": "Company",
          "type": "string"
        },
        "sort_by": {
          "default": "balanced",
          "enum": [
            "balanced",
            "popular"
          ],
          "title": "Sort By",
          "type": "string"
        },
        "era": {
          "default": "any",
          "enum": [
            "any",
            "recent",
            "2000s",
            "classic"
          ],
          "title": "Era",
          "type": "string"
        }
      },
      "title": "Constraints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "discover",
        "watchlist",
        "known_movie"
      ],
      "title": "Mode",
      "type": "string"
    },
    "query": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "region": {
      "default": "CN",
      "pattern": "^[A-Z]{2}$",
      "title": "Region",
      "type": "string"
    },
    "session_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "memory_enabled": {
      "default": false,
      "title": "Memory Enabled",
      "type": "boolean"
    },
    "clarification_count": {
      "default": 0,
      "maximum": 2,
      "minimum": 0,
      "title": "Clarification Count",
      "type": "integer"
    },
    "movie_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Movie Id"
    },
    "watchlist_movie_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Watchlist Movie Ids",
      "type": "array"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "input_source": {
      "default": "structured",
      "enum": [
        "structured",
        "natural_language"
      ],
      "title": "Input Source",
      "type": "string"
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClarificationSubmission"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "mode",
    "query",
    "session_id"
  ],
  "title": "RecommendationRequest",
  "type": "object"
}
